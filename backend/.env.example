# Adora AI Python Backend Environment Configuration

# Nebius Token Factory & NVIDIA Nemotron (Mandatory Hackathon Inference)
NEBIUS_API_KEY="your-nebius-api-key"
NEBIUS_BASE_URL="https://api.studio.nebius.ai/v1"
NEBIUS_MODEL="nvidia/nemotron-4-340b-instruct"
NEBIUS_FAST_MODEL="nvidia/nemotron-3-8b-instruct"

# Firebase & Firestore
FIREBASE_PROJECT_ID="your-firebase-project-id"
GOOGLE_APPLICATION_CREDENTIALS=""

# Optional Web Research
TAVILY_API_KEY=""

# Application Settings
ENVIRONMENT="production"
PORT=8000
LOG_LEVEL="info"
